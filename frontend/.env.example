# Base URL of the Django API.
VITE_API_BASE_URL=http://localhost:8000

# Public address of the deployed site. Used for canonical URLs, Open Graph tags,
# sitemap.xml and robots.txt. Set this before `npm run build` for production.
VITE_SITE_URL=https://your-domain.example

# Free key from https://www.pexels.com/api/ for `npm run images`. No VITE_ prefix,
# so it is only read by the download script and never reaches the browser.
PEXELS_API_KEY=

# Razorpay Checkout needs no key here: the public key id arrives from the API with each order,
# and the secret key exists only on the server.

# Customer Care contact shown to Hosts on the Subscription page ("Contact Customer Care").
# Plans are bought through Customer Care, not online. Set at least one before building;
# until then the button says the details are not available yet.
VITE_CUSTOMER_CARE_EMAIL=
VITE_CUSTOMER_CARE_PHONE=

# Copy to `.env` and fill in. Never commit the real file (.env is git-ignored).

# --- Django --------------------------------------------------------------------
# DJANGO_DEBUG defaults to OFF. Keep True for local development only. With it off the app
# refuses to start unless DJANGO_SECRET_KEY is a real random value and DJANGO_ALLOWED_HOSTS is set,
# and it turns on HTTPS redirect, secure cookies and HSTS.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of frontend origins allowed to call the API (required when DEBUG is off).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# HTTPS origins allowed to submit the Django admin's forms, e.g. https://api.example.com
# CSRF_TRUSTED_ORIGINS=   # defaults to CORS_ALLOWED_ORIGINS (needed for the cookie-based refresh/logout CSRF check)

# Production HTTPS tuning (all optional).
# DJANGO_BEHIND_PROXY=True          # trust X-Forwarded-Proto from your proxy / load balancer
# DJANGO_SECURE_SSL_REDIRECT=False  # defaults to on when DEBUG is off
# DJANGO_HSTS_SECONDS=31536000
# DJANGO_HSTS_INCLUDE_SUBDOMAINS=False

# --- Email and links -----------------------------------------------------------
# Where the React app lives. Verification and reset emails link to it (https:// required when DEBUG is off).
FRONTEND_URL=http://localhost:5173
# In development emails are printed to the runserver console. With DEBUG off, SMTP is required.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-smtp-user
# EMAIL_HOST_PASSWORD=your-smtp-password
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=Blüdhaven <no-reply@your-domain.example>
# Link lifetimes.
PASSWORD_RESET_TIMEOUT_MINUTES=60
EMAIL_VERIFICATION_TIMEOUT_HOURS=48

# --- Refresh-token cookie --------------------------------------------------------
# The refresh token lives only in an httpOnly cookie scoped to /api/auth/. Secure defaults to ON when DEBUG is off.
# SameSite=Lax needs the SPA and API on the same site (e.g. app.example.com + api.example.com).
# For different sites use REFRESH_COOKIE_SAMESITE=None (requires Secure) and explicit CORS/CSRF origins.
# REFRESH_COOKIE_NAME=bludhaven_refresh
# REFRESH_COOKIE_SECURE=
# REFRESH_COOKIE_SAMESITE=Lax
# REFRESH_COOKIE_DOMAIN=

# --- Image uploads (Cloudinary) ---------------------------------------------------
# cloudinary://<api_key>:<api_secret>@<cloud_name>  (keep secret; server-side only). Uploads return 503 until set.
CLOUDINARY_URL=
CLOUDINARY_ROOT_FOLDER=bludhaven
# Per-image limits. Formats are checked against the real file content, not the filename.
IMAGE_MAX_BYTES=5242880
IMAGE_MAX_PIXELS=40000000
IMAGE_ALLOWED_FORMATS=jpeg,png,webp
THROTTLE_UPLOAD=60/hour

# --- MySQL (required) ----------------------------------------------------------
DB_NAME=bludhaven
DB_USER=your-mysql-user
DB_PASSWORD=your-mysql-password
DB_HOST=127.0.0.1
DB_PORT=3306
# Optional: path to the CA certificate when connecting to a managed MySQL over TLS.
# DB_SSL_CA=

# --- JWT (SimpleJWT) -----------------------------------------------------------
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7
# Optional: a separate signing key. Defaults to DJANGO_SECRET_KEY when empty.
JWT_SIGNING_KEY=

# --- Rate limiting ---------------------------------------------------------------
# Format: <count>/<sec|min|hour|day>. Counters live in Django's cache (per process by default).
THROTTLE_ANON=120/min
THROTTLE_USER=600/min
THROTTLE_AUTH=10/min
THROTTLE_REGISTER=10/hour
THROTTLE_PASSWORD_RESET=5/hour
THROTTLE_RESEND_VERIFICATION=5/hour
# Number of reverse proxies in front of Django (0 = none). Needed for correct per-client limits.
NUM_PROXIES=0

# --- Booking payment (Razorpay) ------------------------------------------------------
# Guest room bookings are paid through Razorpay Checkout. Host subscriptions are NOT (Customer Care).
# Use Razorpay TEST credentials locally (Dashboard -> Account & Settings -> API keys, in Test Mode).
# The key SECRET and webhook secret stay on the server only; never put them in the frontend.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard -> Webhooks -> add https://<public https url>/api/payments/razorpay/webhook/ with events
# payment.captured, order.paid and payment.failed, and paste the secret you choose here.
RAZORPAY_WEBHOOK_SECRET=
# An unpaid booking holds its dates for this many minutes, then expires.
BOOKING_PAYMENT_WINDOW_MINUTES=15
# Host subscriptions: days a Host stays PAST_DUE (still entitled) after a paid period ends, and the largest wallet top-up
# in whole rupees. Plan prices and limits are set by the Super Admin in the app, not here.
SUBSCRIPTION_GRACE_DAYS=3
WALLET_TOPUP_MAX_RUPEES=100000
THROTTLE_PAYMENT=30/min
THROTTLE_REFRESH=30/min
THROTTLE_LOGOUT=20/min
THROTTLE_PASSWORD_CHANGE=10/hour

# --- Logging ---------------------------------------------------------------------
LOG_LEVEL=INFO

# Host onboarding: unpublished drafts a Host may keep, and photos per draft, before a plan is chosen.
MAX_DRAFTS_PER_HOST=3
DRAFT_MAX_IMAGES=10

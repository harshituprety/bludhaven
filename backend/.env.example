# Copy to `.env` and fill in. Never commit the real file (.env is git-ignored).

# --- Django --------------------------------------------------------------------
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of frontend origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- MySQL (required) ----------------------------------------------------------
DB_NAME=bludhaven
DB_USER=your-mysql-user
DB_PASSWORD=your-mysql-password
DB_HOST=127.0.0.1
DB_PORT=3306
# Optional: path to the CA certificate when connecting to a managed MySQL over TLS.
# DB_SSL_CA=

# --- JWT (SimpleJWT) -----------------------------------------------------------
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7
# Optional: a separate signing key. Defaults to DJANGO_SECRET_KEY when empty.
JWT_SIGNING_KEY=

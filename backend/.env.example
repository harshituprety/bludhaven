# Copy to `.env` and adjust. All values are optional for local development;
# the defaults in config/settings.py work out of the box.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of frontend origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database: SQLite is used for now (backend/db.sqlite3), so no DB variables are
# needed yet. PostgreSQL settings will be added when that decision is made.
